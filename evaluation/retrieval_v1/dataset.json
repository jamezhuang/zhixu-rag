  "cases": [
    {
      "id": "R001",
      "category": "single",
      "question": "公司主要为哪些客户提供什么服务？",
      "as_of": "2026-10-21",
      "answerable": true,
      "gold": [
        {
          "document": "BIZ-001@1.0",
          "quote": "服务对象是已签约的品牌客户。"
        }
      ]
    },
    {
      "id": "R002",
      "category": "single",
      "question": "广告代投属于所有客户的标准服务吗？",
      "as_of": "2026-10-21",
      "answerable": true,
      "gold": [
        {
          "document": "BIZ-002@1.0",
          "quote": "广告代投只有在合同明确包含时才提供。"
        }
      ]
    },
    {
      "id": "R003",
      "category": "single",
      "question": "销售、客服和投放组分别负责什么？",
      "as_of": "2026-10-21",
      "answerable": true,
      "gold": [
        {
          "document": "ORG-001@1.0",
          "quote": "投放组负责广告计划与执行"
        }
      ]
    },
    {
      "id": "R004",
      "category": "single",
      "question": "运营专员日常要做哪些工作？",
      "as_of": "2026-10-21",
      "answerable": true,
      "gold": [
        {
          "document": "JOB-001@1.0",
          "quote": "运营专员维护商品、编写活动方案、检查库存与页面、提交周报"
        }
      ]
    },
    {
      "id": "R005",
      "category": "single",
      "question": "正式客服可以自行修改促销规则吗？",
      "as_of": "2026-10-21",
      "answerable": true,
      "gold": [
        {
          "document": "JOB-002@1.0",
          "quote": "客服不得自行修改促销规则或承诺未批准的折扣。"
        }
      ]
    },
    {
      "id": "R006",
      "category": "single",
