# Copy this file to .env. No key is needed in demo mode.
APP_MODE=demo
DATABASE_URL=sqlite:///./data/app.db
AUTH_SECRET=
ADMIN_PASSWORD=
EMPLOYEE_PASSWORD=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=false
DEEPSEEK_MAX_TOKENS=2400
SILICONFLOW_API_KEY=
# International account (.com): api.ap.siliconflow.com; mainland account (.cn): api.siliconflow.cn
SILICONFLOW_BASE_URL=https://api.ap.siliconflow.com/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MODEL_PATH=data/models/bge-reranker-v2-m3
RERANK_DEVICE=cpu
RERANK_BATCH_SIZE=4
RERANK_MAX_LENGTH=512
RERANK_CPU_THREADS=4
RERANK_PRECISION=int8
MILVUS_URI=http://localhost:19531
POSTGRES_PORT=55432
MILVUS_PORT=19531
MILVUS_HTTP_PORT=19091
MILVUS_COLLECTION=zhixu_qwen06_1024
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=zhixu-rag
FEISHU_APP_ID=
FEISHU_APP_SECRET=
PUBLIC_APP_URL=http://localhost:5173
MEMORY_TOKEN_BUDGET=4000
# Per-model-call total budget; output and safety reserves are deducted from it.
CONTEXT_TOKEN_BUDGET=16000
CONTEXT_SAFETY_TOKENS=800
CONTEXT_LIGHT_RATIO=0.5
CONTEXT_MEDIUM_RATIO=0.7
CONTEXT_COMPACT_RATIO=0.85
SUMMARY_TRIGGER_RATIO=0.7
RECENT_ROUNDS=4
MAX_RETRIEVAL_CALLS=6
MAX_QUERY_RETRIES=2
STRUCTURED_OUTPUT_MAX_ATTEMPTS=2
REQUEST_TIMEOUT_SECONDS=300
HNSW_EF=64
# Development-only fault injection. Never turn on for shared deployments.
ENABLE_FAULT_INJECTION=false
